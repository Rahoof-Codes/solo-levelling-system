{
  "expo": {
    "name": "SOLO",
    "slug": "SOLO",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "solo",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#070B14"
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#070B14",
      "barStyle": "light-content"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSMotionUsageDescription": "Allow SOLO to access your device motion and pedometer to track your daily 10,000 steps quest."
      }
    },
    "android": {
      "package": "com.abdul.sololevelling",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#070B14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070B14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@react-native-google-signin/google-signin",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow SOLO to access your device motion and pedometer to track your daily 10,000 steps quest."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
